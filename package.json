{
  "name": "sense-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for the $SENSE points token: a fixed-supply credit that is spent on SenseAI and cannot be moved between holders.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "lint": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write 'contracts/**/*.sol' 'test/**/*.js' 'scripts/**/*.js'",
    "format:check": "prettier --check 'contracts/**/*.sol' 'test/**/*.js' 'scripts/**/*.js'",
    "deploy:localnet": "ENV_FILE=.env.localnet hardhat run scripts/deploy.js --network localhost",
    "deploy:testnet": "ENV_FILE=.env.testnet hardhat run scripts/deploy.js --network baseSepolia",
    "deploy:mainnet": "ENV_FILE=.env.mainnet hardhat run scripts/deploy.js --network base"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TradableApp/sense-contracts.git"
  },
  "keywords": [
    "ERC20",
    "smart-contracts",
    "token",
    "points",
    "SenseAI"
  ],
  "author": "Tradable",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.0.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@openzeppelin/upgrades-core": "^1.44.1",
    "chai": "^4.2.0",
    "dotenv": "^17.0.1",
    "hardhat": "^2.25.0",
    "hardhat-gas-reporter": "^2.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.0.0",
    "solhint": "^6.0.0",
    "solidity-coverage": "^0.8.16"
  },
  "overrides": {
    "lodash": "4.18.1"
  }
}
